DOCUMENT_SERVICE_KEY=
DOCUMENT_BIND=127.0.0.1
PORT=3100
DOCUMENT_MAX_CONCURRENT=2
# Production: persistent private directory shared by replicas, outside temp storage.
DOCUMENT_NONCE_DIR=/var/lib/document-service/nonces
DOCUMENT_TEMP_DIR=/var/lib/document-service/tmp
DOCUMENT_BROWSER_CHANNEL=chromium
DOCUMENT_PYTHON_BINARY=/opt/documents-venv/bin/python
DOCUMENT_PHP_BINARY=php
